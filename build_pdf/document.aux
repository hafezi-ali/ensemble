\newlabel{eq:Gaussian-distributions1}{{1}{5}{GMM Clustering \& Sampling}{equation.3.1}{}}
\newlabel{eq:Gaussian-distributions2}{{2}{5}{GMM Clustering \& Sampling}{equation.3.2}{}}
\citation{dempster_maximum_1977}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The DDEL-GMM pipeline. \textsc  {Fit}: a Gaussian mixture with full covariance matrices is estimated by EM over the $157$ retained principal components, yielding $\mu _k$, $\Sigma _k$ and $\pi _k$ for $K=6$ components. \textsc  {Select}: the training rows are ranked by distance to each $\mu _k$ and the nearest $\phi m$ are retained, where $\phi $ is a fraction of the \emph  {entire} training set rather than of a single cluster; the six resulting subsets therefore overlap ($42\%$ pairwise at the cross-validated operating point $\phi = 0.5$). \textsc  {Weight}: at inference each base learner $f_k$ is weighted by the mixture posterior $\gamma _k(x^*) \propto \pi _k\,\mathcal  {N}(x^* \mid \mu _k, \Sigma _k)$, so the weighting---unlike inverse-distance schemes---is anisotropic and carries the full component covariance. Dataset: UCI HAR, $10{,}299$ instances.}}{6}{figure.1}\protected@file@percent }
\newlabel{fig:overview}{{1}{6}{The DDEL-GMM pipeline. \textsc {Fit}: a Gaussian mixture with full covariance matrices is estimated by EM over the $157$ retained principal components, yielding $\mu _k$, $\Sigma _k$ and $\pi _k$ for $K=6$ components. \textsc {Select}: the training rows are ranked by distance to each $\mu _k$ and the nearest $\phi m$ are retained, where $\phi $ is a fraction of the \emph {entire} training set rather than of a single cluster; the six resulting subsets therefore overlap ($42\%$ pairwise at the cross-validated operating point $\phi = 0.5$). \textsc {Weight}: at inference each base learner $f_k$ is weighted by the mixture posterior $\gamma _k(x^*) \propto \pi _k\,\mathcal {N}(x^* \mid \mu _k, \Sigma _k)$, so the weighting---unlike inverse-distance schemes---is anisotropic and carries the full component covariance. Dataset: UCI HAR, $10{,}299$ instances}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Training phase of proposed model}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:training_phase_diagram}{{2}{6}{Training phase of proposed model}{figure.2}{}}
\newlabel{eq:E-Step}{{3}{6}{GMM Clustering \& Sampling}{equation.3.3}{}}
\citation{dempster_maximum_1977}
