\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces Instance-selection rule at partitioning time, UCI HAR, $K = 6$, logistic-regression base learners, DensityE aggregation. \emph  {Distance} ranks by Euclidean distance to $\mu _i$ (our implementation); \emph  {responsibility} ranks by the component posterior $\gamma _i(x_j)$, which uses $\Sigma _i$. Disagreement is the mean pairwise fraction of test instances on which two base learners differ; overlap is the mean pairwise Jaccard index of the training subsets. Ensemble weights are the GMM responsibilities in both columns. The selected operating point is shown in bold.}}{8}{table.1}\protected@file@percent }
\newlabel{tab:selection_rule}{{I}{8}{Instance-selection rule at partitioning time, UCI HAR, $K = 6$, logistic-regression base learners, DensityE aggregation. \emph {Distance} ranks by Euclidean distance to $\mu _i$ (our implementation); \emph {responsibility} ranks by the component posterior $\gamma _i(x_j)$, which uses $\Sigma _i$. Disagreement is the mean pairwise fraction of test instances on which two base learners differ; overlap is the mean pairwise Jaccard index of the training subsets. Ensemble weights are the GMM responsibilities in both columns. The selected operating point is shown in bold}{table.1}{}}
\newlabel{eq: Density-Estimation}{{4}{8}{Density-based Dynamic Ensemble Algorithm}{equation.3.4}{}}
